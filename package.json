{
  "name": "hamsterstore",
  "version": "1.0.0",
  "description": "跨平台开源软件仓库管理工具 — 仓鼠软库 (FileDB + Perry UI + Bento)",
  "main": "src/main.ts",
  "scripts": {
    "check": "perry check",
    "types": "perry types",
    "build:cli": "perry compile src/main.ts -o dist/HamsterStore.exe",
    "build:gui": "perry compile src/gui/main.ts -o dist/HamsterStore-GUI.exe --target windows --min-windows-version 10",
    "build:all": "npm run build:cli && npm run build:gui",
    "dev:windows": "perry dev --target windows",
    "test": "echo 'Run tests manually: compile test/*.ts with perry'",
    "clean": "rm -rf dist"
  },
  "keywords": ["github", "proxy", "download", "trending", "accelerate", "perry", "hamsterstore", "filedb"],
  "author": "HamsterStore Team",
  "license": "MIT",
  "dependencies": {
    "@perryts/perry": "^0.5.1220"
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  }
}
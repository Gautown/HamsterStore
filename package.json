{
  "name": "hamsterstore",
  "version": "1.0.0",
  "description": "跨平台开源软件仓库管理工具 — 仓鼠软库 (FileDB + Perry UI + Bento)",
  "main": "src/main.ts",
  "scripts": {
    "check": "perry check",
    "types": "perry types",
    "build:cli": "bash scripts/build.sh cli",
    "build:gui": "bash scripts/build.sh gui",
    "build:all": "bash scripts/build.sh all",
    "dev:windows": "perry dev --target windows",
    "test": "bash scripts/test-concurrent.sh && bash scripts/test-filedb.sh && bash scripts/test-release.sh",
    "test:concurrent": "bash scripts/test-concurrent.sh",
    "test:filedb": "bash scripts/test-filedb.sh",
    "test:release": "bash scripts/test-release.sh",
    "test:net": "bash scripts/test-net.sh",
    "test:gui": "bash scripts/test-gui-smoke.sh",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "github",
    "proxy",
    "download",
    "trending",
    "accelerate",
    "perry",
    "hamsterstore",
    "filedb"
  ],
  "author": "HamsterStore Team",
  "license": "MIT",
  "dependencies": {
    "@perryts/perry": "0.5.1520"
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  }
}
